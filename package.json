{
  "name": "osama-portfolio",
  "version": "4.1.0",
  "private": true,
  "description": "Bilingual (AR/EN) static portfolio served from GitHub Pages",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/tailwind.css -o assets/css/tailwind.css --watch",
    "start": "node scripts/serve.mjs",
    "test": "playwright test",
    "check:sri": "node scripts/check-sri.mjs",
    "mirror:cdn": "node scripts/mirror-cdn.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "tailwindcss": "3.4.19"
  }
}
