{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs",
      "startServerReadyPattern": "Serving",
      "url": ["http://localhost:4173/CV/"],
      "numberOfRuns": 3,
      "settings": {
        "blockedUrlPatterns": ["*googletagmanager.com*", "*google-analytics.com*", "*clarity.ms*"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
